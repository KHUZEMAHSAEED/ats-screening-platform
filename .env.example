# ==============================================================================
# ATS RESUME SCREENING & CANDIDATE GOVERNANCE PLATFORM - ENVIRONMENT TEMPLATE
# Copy this file to .env and configure for your deployment environment.
# NEVER commit the active .env file containing real secrets to version control!
# ==============================================================================

# Deployment Environment ('development', 'staging', or 'production')
ENVIRONMENT=development

# Backend & Cryptographic Security
PROJECT_NAME="ATS Screening System"
# REQUIRED in production: Generate using `openssl rand -hex 32` or python `secrets.token_hex(32)`
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Initial Seed Credentials for HR Admin User
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=AdminPass123!

# Allowed CORS Origins (comma-separated domains, no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Production / Docker PostgreSQL:
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_secure_password_2026
POSTGRES_DB=ats_database
DATABASE_URL=postgresql://ats_user:ats_secure_password_2026@localhost:5432/ats_database
# For local SQLite development without PostgreSQL:
# DATABASE_URL=sqlite:///./ats.db

# Asynchronous Task Queue (Redis / Celery)
REDIS_URL=redis://localhost:6379/0
# Set USE_IN_PROCESS_TASKS=true for lightweight local development without standalone Celery workers
USE_IN_PROCESS_TASKS=true

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# OCR Processing
ENABLE_OCR=true
# Optional custom Tesseract binary path on Windows (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# AI / LLM Hybrid Reasoning Engine (Optional & Configurable)
# Set ENABLE_LLM_ENRICHMENT=true and provide OPENAI_API_KEY to enable live qualitative analysis.
# Leave blank to use zero-config deterministic heuristic fallback.
ENABLE_LLM_ENRICHMENT=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
