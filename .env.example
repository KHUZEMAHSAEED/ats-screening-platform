# ==============================================================================
# ATS RESUME SCREENING & CANDIDATE GOVERNANCE PLATFORM - ENVIRONMENT TEMPLATE
# ==============================================================================

# Backend & Security
PROJECT_NAME="ATS Screening System"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (PostgreSQL for production/docker, or SQLite for zero-config local run)
DATABASE_URL=postgresql://ats_user:ats_secure_password_2026@localhost:5432/ats_database
# For local SQLite development without PostgreSQL:
# DATABASE_URL=sqlite:///./ats.db

# Asynchronous Task Queue (Redis / Celery)
REDIS_URL=redis://localhost:6379/0
# If Redis is not available locally, set USE_IN_PROCESS_TASKS=true to use the in-process worker pool
USE_IN_PROCESS_TASKS=true

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# OCR Fallback
ENABLE_OCR=true
# Optional custom Tesseract binary path on Windows (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# Optional AI / LLM Enrichment (Leave blank for deterministic rule-based matching only)
ENABLE_LLM_ENRICHMENT=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
