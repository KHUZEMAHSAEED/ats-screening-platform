# ==============================================================================
# TALENTFILTER AI - ENTERPRISE GITIGNORE
# Ensures all local configurations, secrets, keys, and environments are never committed
# ==============================================================================

# 1. Environment & Secret Configurations (Strict Protection)
.env
.env.*
.env*.local
*.env
!.env.example

# 2. Cryptographic Keys, Certificates & Cloud Credentials
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
credentials.json
client_secret*.json
service_account*.json

# 3. Python Virtual Environments
venv/
backend/venv/
.venv/
env/
ENV/

# 4. Python Cache, Bytecode & Testing Artifacts
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 5. Databases, Storage & Local Uploads
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
backend/ats.db*
backend/uploads/
uploads/

# 6. Node.js & Next.js Build Outputs
node_modules/
frontend/node_modules/
frontend/.next/
.next/
out/
build/
dist/

# 7. System, Logs & Editor Artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
scratch/
